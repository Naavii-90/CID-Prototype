import cv2
import os
import time
import numpy as np

def predict(image_path):
    img = cv2.imread(image_path)
    img = cv2.resize(img, (128, 128))
    img = img / 255.0

    # fake baseline logic (replace with MesoNet later if needed)
    score = np.mean(img) * 100
    return score


def evaluate():
    results = []

    for label in ["real", "fake"]:
        folder = f"dataset/{label}"

        for file in os.listdir(folder):
            path = os.path.join(folder, file)

            start = time.time()
            score = predict(path)
            end = time.time()

            predicted = "fake" if score > 50 else "real"

            results.append({
                "file": file,
                "true": label,
                "pred": predicted,
                "time_ms": (end - start) * 1000
            })

    return results


results = evaluate()

for r in results:
    print(r)
